# Copy to /etc/tuxbox-release.env, chmod 0640, and give it to the
# build user's group.
# Never commit the real file - it holds the GitHub token.
TUXBOX_WORK_ROOT=/mnt/C/tuxbox-build
TUXBOX_TMP_ROOT=/mnt/build
TUXBOX_ARCHIVE_ROOT=/mnt/archiv/releases
TUXBOX_IMAGE=tuxbox-build:ci
TUXBOX_MACHINES=hd51:mutant51,hd60:ax60,h7:zgemmah7
TUXBOX_REPO=tuxbox-neutrino/build-environment
# Repository that receives the release. GitHub attaches "Source code"
# archives to every release tag; in TUXBOX_REPO those would be the build
# system. Issues and the source link stay with TUXBOX_REPO. The release
# tag goes onto that repository's default branch, so it needs at least
# one commit. Leave empty to publish into TUXBOX_REPO itself.
TUXBOX_RELEASE_REPO=
TUXBOX_CHANNEL=release
# Caches served from another host, comma separated. Absolute paths,
# mounted at the same path inside the container. Leave empty if there
# is no second host.
TUXBOX_MIRRORS=
# Repository whose newest release carries the PC AppImage. It is
# only linked from the release notes, never copied - it is built
# separately and from its own source state. Leave empty to omit.
TUXBOX_APPIMAGE_REPO=
TUXBOX_MAIL_TO=CHANGEME@example.org
GH_TOKEN=CHANGEME
