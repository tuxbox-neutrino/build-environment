# Local site configuration for Tuxbox-OS builds
#
# This file is created by tuxbox-os-builder only when it does not already
# exist. It is the central user-editable configuration for this checkout.
# Machine-only overrides belong in builds/<machine>/conf/local.conf.<machine>.inc.

#
# Distribution selection
#
DISTRO ?= "##DISTRO##"
DISTRO_TYPE ?= "##DISTRO_TYPE##"

#
# Download and shared-state directories
#
DL_DIR ?= "##DL_DIR##"
SSTATE_DIR ?= "##SSTATE_DIR##"

#
# Source download mirror
#
INHERIT += "own-mirrors"
SOURCE_MIRROR_URL = "https://archiv.tuxbox-neutrino.org/"
# Optional: fail if the mirror misses a source (no upstream fetch)
# BB_FETCH_PREMIRRORONLY = "1"

#
# Shared-state mirror
#
SSTATE_MIRRORS ?= "file://.* https://sstate.tuxbox-neutrino.org/kirkstone/release/PATH;downloadfilename=PATH"

#
# Interactive patch handling
#
# Fail on patch conflicts instead of opening an interactive resolver.
PATCHRESOLVE = "noop"

#
# Disk space monitoring
#
BB_DISKMON_DIRS ??= "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    STOPTASKS,${SSTATE_DIR},1G,100K \
    STOPTASKS,/tmp,100M,100K \
    HALT,${TMPDIR},100M,1K \
    HALT,${DL_DIR},100M,1K \
    HALT,${SSTATE_DIR},100M,1K \
    HALT,/tmp,10M,1K"

#
# SDK and QEMU host defaults
#
SDKMACHINE ?= "x86_64"
PACKAGECONFIG:append:pn-qemu-system-native = " sdl"
# PACKAGECONFIG:append:pn-qemu-system-native = " gtk+"

#
# Hash equivalence
#
# A local hashserv has a different unihash context than the public sstate
# mirror, so keep it disabled unless you operate a shared upstream hashserv.
BB_HASHSERVE = ""
BB_SIGNATURE_HANDLER = "OEBasicHash"
# BB_HASHSERVE = "auto"
# BB_HASHSERVE_UPSTREAM = "hashserv.tuxbox-neutrino.org:8686"
# BB_SIGNATURE_HANDLER = "OEEquivHash"

# Keep this aligned with poky/meta-poky/conf/local.conf.sample.
CONF_VERSION = "2"

#
# Optional compiler cache
#
# INHERIT += "ccache"
# CCACHE_DIR = "${HOME}/.ccache"
# export CCACHE_MAXSIZE = "30G"

#
# Optional parallelism overrides
#
# Defaults are BitBake/OE auto values. Uncomment only for local tuning.
# BB_NUMBER_THREADS = "8"
# PARALLEL_MAKE = "-j 8"

#
# Optional feed and Online-Flash URL overrides
#
# make config writes local package feed defaults per machine to
# builds/<machine>/conf/local-feed.inc. Disable them with LOCAL_FEED=0.
# make config writes local image update defaults per machine to
# builds/<machine>/conf/local-image-server.inc. Disable them with
# LOCAL_IMAGE_SERVER=0.
#
# For public or server-side builds, override the generated local defaults here:
# IPK_FEED_SERVER = "https://feeds.example.org/tuxbox/${MACHINE}/ipk"
# TUXBOX_IMAGE_UPDATE_BASE_URL = "https://images.example.org/feed"
# TUXBOX_IMAGE_MANIFEST_FILE = "manifest.json"
# TUXBOX_SERVICE_KEY = "public-update-service-key"

#
# Optional image naming overrides
#
# A) Timestamped names
# IMAGE_NAME = "${IMAGE_BASENAME}-${MACHINE}-${DATETIME}"
# IMAGE_NAME[vardepsexclude] = "DATETIME"
# IMAGE_VERSION ?= "${DISTRO_VERSION}"
# IMAGE_NAME_SUFFIX = ".tuxbox"
# IMAGE_VER_STRING = "${DISTRO_NAME}-${IMAGE_VERSION}-${MACHINEBUILD}-${DATE}"
# IMAGE_VER_STRING[vardepsexclude] += "DATE"
#
# B) Deterministic names
# IMAGE_NAME = "${IMAGE_BASENAME}-${MACHINE}"
# IMAGE_VERSION ?= "${DISTRO_VERSION}"
# IMAGE_NAME_SUFFIX = ".tuxbox"
# IMAGE_VER_STRING = "${DISTRO_NAME}-${IMAGE_VERSION}-${MACHINEBUILD}"
#
# C) Include MACHINEBUILD in filename
# IMAGE_NAME = "${IMAGE_BASENAME}-${MACHINE}-${MACHINEBUILD}-${DATETIME}"
# IMAGE_NAME[vardepsexclude] = "DATETIME"
